{
  "name": "pull-requests",
  "displayName": "Pull Requests",
  "description": "The session's pull requests, their checks, reviewers, labels, merge, comments and diff, in the workspace rail's Pull Requests tab.",
  "publisher": "omnigent",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "omnigent": "*"
  },
  "activationEvents": [
    "*"
  ],
  "browser": "./extension.ts",
  "contributes": {
    "views": {
      "omnigent.rightPanel": [
        {
          "id": "omnigent.pull-requests.view",
          "name": "Pull Requests",
          "when": "omnigent.session.hasWorkspace",
          "icon": "git-pull-request",
          "builtInTab": "github"
        }
      ]
    }
  }
}
